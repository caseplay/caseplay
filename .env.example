AI_PROVIDER=gemini
AI_API_KEY=
# 可分别保存各平台密钥，AI_PROVIDER 选择当前平台
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# 可选：自定义 OpenAI 兼容网关时同时指定以下两项
# AI_BASE_URL=https://your-gateway.example/v1
# AI_MODEL=your-model
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lmt
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=lmt
MYSQL_ROOT_PASSWORD=change-this-root-password
MAIL_SENDER=
MAIL_API_KEY=

# 本机访问端口，冲突时可改为 8081 等
CASEPLAY_PORT=8080
# 可选：指定兼容的 MySQL 镜像
MYSQL_IMAGE=mysql:8.4
